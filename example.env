DEBUG=1

# === TEMPERATURE STRATEGY (Stage-Specific) ===
# General fallback temperatures (used if stage-specific not set)
# TEMP=0.01
# TEMP2=0.7

# Stage-specific temperatures (recommended for fine-tuned control)
TEMP_INITIAL=0.01        # Stage 1: Initial translation (consistency)
TEMP_REFLECTION=0.4      # Stage 2: Quality review (creative analysis)
TEMP_IMPROVE=0.4         # Stage 3: Apply suggestions (flexible editing)
TEMP_FINAL_EDIT=0.15     # Stage 4: Final proofreading (precision)
TEMP_SYNOPSIS=0.15       # Stage 5: Synopsis generation (accuracy)

# === JSON MODE CONTROL FOR LOCAL LLMs ===
# Default: true (disabled) - local LLMs often struggle with JSON mode
# Set to 'false' to enable JSON mode if your LLM supports it correctly
# DISABLE_JSON_MODE_TRANSLATE=true
# DISABLE_JSON_MODE_PROOFREAD=true
