# S_PROMT_PROOFREAD=false
#
# SOURCE_LANG=english
# TARGET_LANG=russian
# COUNTRY=Russia
# NER=true
# NERMODEL=en_core_web_lg
# MAX_LEN_CHUNK=6192
# DEBUG=off
# FAST_TRANS=off
# OUTPUT_FORMAT=fb2
#
