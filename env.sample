# Sunny Narrator Configuration Reference
# ======================================
# Full reference file with all options and documentation.
# Copy to .env and configure for your setup.
# Values below are a working setup: Korean → Russian with two local LLMs.
#
# Version: 2.2
# Updated: 2026-09-22

# =============================================================================
# SOURCE AND TARGET LANGUAGES
# =============================================================================

# SOURCE_LANG / TARGET_LANG: full name or ISO code (korean/ko, russian/ru,
# english/en, chinese/zh, japanese/ja, german/de, ...). SOURCE_LANG also selects
# the spaCy NER model and the CJK adaptations (ko/ja/zh).
# Defaults: english → russian
SOURCE_LANG=ko
TARGET_LANG=ru

# COUNTRY: target country for localization context in prompts (default: Россия)
COUNTRY=Россия

# =============================================================================
# FILE SETTINGS
# =============================================================================

# FILE: path to the source book (relative or absolute)
# FB2, TXT → classic pipeline; EPUB, DOCX, PDF → Calibre pipeline
# Can also be passed per run: FILE=books/mybook.epub python app.py
FILE=books/ExampleBook.fb2

# =============================================================================
# PRIMARY LLM (TRANSLATE) - Initial translation + Synopsis
# =============================================================================

# API key (use any non-empty string for local servers without auth)
API_KEY_TRANSLATE=your-api-key-here

# OpenAI-compatible base URL (llama.cpp, Ollama, LM Studio, vLLM, OpenAI ...)
API_BASE_TRANSLATE=http://localhost:11434/v1

# Model name as served by the API
# Examples: Gemma4-26B, Qwen36-35B, Mistral, Hunyuan, GigaChat, TranslateGemma
MODEL_TRANSLATE=Gemma4-26B

# TEMP_TRANSLATE: base temperature (fallback for TEMP_INITIAL). Default: 0.01
TEMP_TRANSLATE=0.01

# TIMEOUT_TRANSLATE: request timeout in SECONDS. Default: 6000
# Large local models on long chunks may need an hour or more
TIMEOUT_TRANSLATE=7200

# NOTHINK_TRANSLATE: disable the model's thinking/reasoning mode (1/true). Default: false
NOTHINK_TRANSLATE=1

# S_PROMT_TRANSLATE: set true for models WITHOUT system prompt support
# (the system prompt is then merged into the user message). Default: false
S_PROMT_TRANSLATE=false

# =============================================================================
# SECONDARY LLM (PROOFREAD) - Reflection + Improve + Final edit
# =============================================================================

API_KEY_PROOFREAD=your-api-key-here
API_BASE_PROOFREAD=http://localhost:11434/v1
# Examples: Qwen36-35B, gpt-oss-20b, Nemotron, tencent/Hunyuan-MT-7B
MODEL_PROOFREAD=Qwen36-35B

# TEMP_PROOFREAD: base temperature for proofreading. Default: 0.7
TEMP_PROOFREAD=0.3

# TIMEOUT_PROOFREAD: request timeout in SECONDS. Default: 6000
TIMEOUT_PROOFREAD=7200

# NOTHINK_PROOFREAD: disable thinking mode (1/true). Default: false
NOTHINK_PROOFREAD=1

# S_PROMT_PROOFREAD: same meaning as S_PROMT_TRANSLATE. Default: false
S_PROMT_PROOFREAD=false

# =============================================================================
# STAGE-SPECIFIC TEMPERATURES (override the base temperatures)
# =============================================================================
# Stage 1: INITIAL     - initial translation      (default: TEMP_TRANSLATE)
# Stage 2: REFLECTION  - quality review            (default: 0.4)
# Stage 3: IMPROVE     - apply review suggestions  (default: 0.4)
# Stage 4: FINAL_EDIT  - final proofreading        (default: 0.15)
# Stage 5: SYNOPSIS    - synopsis for next chunk   (default: 0.15)
TEMP_INITIAL=0.05
TEMP_REFLECTION=0.2
TEMP_IMPROVE=0.2
TEMP_FINAL_EDIT=0.1
TEMP_SYNOPSIS=0.15

# =============================================================================
# JSON MODE
# =============================================================================

# JSON_MODE: structured JSON input/output for all 5 stages (more reliable
# parsing). Recommended: true. Default: false (XML tags)
JSON_MODE=true

# Legacy per-role switches, used only when JSON_MODE is not true.
# Default: true (JSON disabled) - some local LLMs handle JSON mode poorly
# DISABLE_JSON_MODE_TRANSLATE=true
# DISABLE_JSON_MODE_PROOFREAD=true

# =============================================================================
# IMAGES API (optional - cover generation)
# =============================================================================

# May stay empty if covers are not generated
# API_KEY_IMAGES=
# API_BASE_IMAGES=
# MODEL_IMAGES=gpt-image-1.5
# COVER_PROMPT=Create a book cover for {title} by {author}

# =============================================================================
# PROCESSING SETTINGS
# =============================================================================

# MAX_LEN_CHUNK: maximum chunk size in source characters. Default: 8192
# For CJK sources the translation is 2-4x longer in characters: make sure the
# translated chunk still fits the model's output token limit.
MAX_LEN_CHUNK=10000

# LENGTH_CHECK_THRESHOLD: allowed deviation (%) of a translated chunk from the
# expected length before it is split and retranslated. Default: 20
# The expected target/source ratio is learned per book (median of accepted
# chunks); during the first 3 chunks only gross failures (<×0.25 or ≥×5) split.
LENGTH_CHECK_THRESHOLD=15

# FAST_TRANS: skip stages 2-4 (REFLECTION, IMPROVE, FINAL_EDIT); only
# INITIAL + SYNOPSIS run. ~2.5x faster, lower quality - drafts only.
# Default: on (!) - set false for literary translation
FAST_TRANS=false

# CONCURRENT_LIMIT: reserved, currently not used (chunks are translated
# sequentially). Default: 1
CONCURRENT_LIMIT=1

# CUDA_VISIBLE_DEVICES: standard CUDA variable - which GPU spaCy/PyTorch use
# CUDA_VISIBLE_DEVICES=0

# =============================================================================
# NER (Named Entity Recognition) - dictionary creation
# =============================================================================

# NER: build the dictionary from named entities (true/1). Default: true
NER=true

# NERMODEL: spaCy model; empty = chosen by SOURCE_LANG and downloaded
# automatically: en → en_core_web_lg, ru → ru_core_news_lg,
# ko → ko_core_news_lg, ja → ja_core_news_lg, zh → zh_core_web_lg, ...
# (full mapping: src/config.py, lang_model_map)
NERMODEL=ko_core_news_lg

# =============================================================================
# OUTPUT SETTINGS
# =============================================================================

# OUTPUT_FORMAT: result format. Default: fb2
#   classic pipeline (FB2/TXT input):    fb2 | epub
#   Calibre pipeline (EPUB/DOCX/PDF):    epub | docx | pdf (fb2 → epub is used)
# The result is written next to the source file with a language marker.
OUTPUT_FORMAT=fb2

# FB2_AUTO_REPAIR: on XML validation failure save both the original and a
# repaired _fixed version. Default: false
FB2_AUTO_REPAIR=false

# =============================================================================
# CALIBRE PIPELINE SETTINGS (EPUB/DOCX/PDF input)
# =============================================================================

# PANDOC_BATCH_CHARS: markdown is converted to HTML in batches of this many
# characters (prevents pandoc hangs/OOM on large books). Default: 200000
PANDOC_BATCH_CHARS=200000

# PANDOC_TIMEOUT / CALIBRE_TIMEOUT: seconds before a pandoc batch /
# ebook-convert is killed. Defaults: 900 / 1800
PANDOC_TIMEOUT=900
CALIBRE_TIMEOUT=1800

# MAX_FAILED_CHUNK_RATIO: fraction (0.0-1.0) of chunks allowed to fail before
# the pipeline aborts. Default: 0.0 (any failure aborts)
MAX_FAILED_CHUNK_RATIO=0.0

# =============================================================================
# LOGGING (see docs/LOGGING.md)
# =============================================================================

# DEBUG: detailed console log - length checks, dictionary matching,
# synopsis, NER (on/1/true). Default: off
DEBUG=1

# DEBUG_HTTP: with DEBUG on, also show raw httpx/httpcore/openai traces and
# duplicate pypandoc lines. Default: off
DEBUG_HTTP=off

# LLM_LOGGING: every LLM call (prompts, response, tokens, timing) as JSON lines
# in LLM_LOGGING_DIR/llm_calls_YYYY-MM-DD.log. Default: false
LLM_LOGGING=false
LLM_LOGGING_DIR=logs

# =============================================================================
# SHORT PASS / EXAMPLES (optional)
# =============================================================================

# SHORT: file with FB2 <section id="..."> values (one per line) - only these
# sections are processed. For tests and partial translations
SHORT=

# EXAMPLE: file with custom abbreviations used during translation
EXAMPLE=

# =============================================================================
# EXAMPLE CONFIGURATIONS
# =============================================================================

# --- English → Russian, local Ollama ---
# SOURCE_LANG=english
# TARGET_LANG=russian
# API_KEY_TRANSLATE=ollama
# API_BASE_TRANSLATE=http://localhost:11434/v1
# MODEL_TRANSLATE=gemma2:27b
# S_PROMT_TRANSLATE=true
# API_KEY_PROOFREAD=ollama
# API_BASE_PROOFREAD=http://localhost:11434/v1
# MODEL_PROOFREAD=mistral:7b
# JSON_MODE=true
# NERMODEL=
# MAX_LEN_CHUNK=6192
# FAST_TRANS=false
#
# --- OpenAI API ---
# API_KEY_TRANSLATE=sk-your-key-here
# API_BASE_TRANSLATE=https://api.openai.com/v1
# MODEL_TRANSLATE=gpt-4o
# API_KEY_PROOFREAD=sk-your-key-here
# API_BASE_PROOFREAD=https://api.openai.com/v1
# MODEL_PROOFREAD=gpt-4o-mini
# TIMEOUT_TRANSLATE=600
# TIMEOUT_PROOFREAD=600
# JSON_MODE=true
# FAST_TRANS=false
#
# --- Fast draft (~2.5x faster) ---
# FAST_TRANS=true    # skip quality stages 2-4
