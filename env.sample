# Sunny Narrator Configuration Reference
# ======================================
# Full reference file with all options and documentation.
# Copy to .env and configure for your setup.
#
# Version: 1.4
# Updated: 2026-05-08

# =============================================================================
# PRIMARY LLM (TRANSLATION) - Translation + Synopsis
# =============================================================================

# API key for Primary LLM (required)
API_KEY_TRANSLATE=your-api-key-here

# Base URL for Primary LLM API (default: Ollama local)
# For local LLM: http://localhost:11434/v1
# For OpenAI-compatible: https://api.openai.com/v1
API_BASE_TRANSLATE=http://localhost:11434/v1

# Model name for Primary LLM (default: Mistral)
# Examples: google/gemma-2-27b-it, mistralai/Mistral-7B, tencent/Hunyuan-MT-7B
MODEL_TRANSLATE=google/gemma-2-27b-it

# S_PROMT_TRANSLATE: Whether model supports system prompts
# Set to 'true' for Gemma 2/3 models that do NOT support system prompts
# Set to 'false' for most other models (Mistral, Llama, Qwen, etc.)
# Default: false
S_PROMT_TRANSLATE=false

# TEMP_TRANSLATE: Base temperature for translation (fallback)
# Lower values (0.01-0.1) for more consistent translations
# Default: 0.01
TEMP_TRANSLATE=0.01

# TIMEOUT_TRANSLATE: Request timeout in milliseconds
# Default: 6000 (6 seconds)
TIMEOUT_TRANSLATE=6000

# JSON_MODE: Use structured JSON for all translation stages
# When 'true': enables JSON mode for all 5 stages (INITIAL, REFLECTION, IMPROVE, FINAL_EDIT, SYNOPSIS)
# When 'false': uses traditional XML tags (legacy mode)
# Recommendation: Set to 'true' for more reliable parsing
# Default: false
# NOTE:Legacy DISABLE_JSON_MODE_* flags are ignored when JSON_MODE=true
JSON_MODE=false

# NOTHINK_TRANSLATE: Disable thinking mode for the model
# Set to 'true' to disable chain-of-thought reasoning
# Default: false
NOTHINK_TRANSLATE=false

# =============================================================================
# STAGE-SPECIFIC TEMPERATURES (override general TEMP_TRANSLATE)
# =============================================================================
# These temperatures apply to each stage of the 5-stage translation pipeline:
# Stage 1: INITIAL - Initial translation to summary
# Stage 2: REFLECTION - Quality review and analysis
# Stage 3: IMPROVE - Apply reflection suggestions
# Stage 4: FINAL_EDIT - Final proofreading and polish
# Stage 5: SYNOPSIS - Synopsis generation

# TEMP_INITIAL: Temperature for initial translation stage
# Lower value for consistency with previous context
# Default: same as TEMP_TRANSLATE (0.01)
TEMP_INITIAL=0.01

# TEMP_REFLECTION: Temperature for reflection stage
# Moderate value to allow creative analysis while maintaining focus
# Default: 0.4
TEMP_REFLECTION=0.4

# TEMP_IMPROVE: Temperature for improvement stage
# Moderate value to allow flexible editing of suggestions
# Default: 0.4
TEMP_IMPROVE=0.4

# TEMP_FINAL_EDIT: Temperature for final proofreading
# Lower value for precision and correctness
# Default: 0.15
TEMP_FINAL_EDIT=0.15

# TEMP_SYNOPSIS: Temperature for synopsis generation
# Lower value for accuracy and completeness
# Default: 0.15
TEMP_SYNOPSIS=0.15

# =============================================================================
# SECONDARY LLM (PROOFREAD) - Quality Review + Style Improvement
# =============================================================================

# API key for Secondary LLM (required for full quality pipeline)
API_KEY_PROOFREAD=your-api-key-here

# Base URL for Secondary LLM API (default: OpenAI-compatible)
API_BASE_PROOFREAD=http://localhost:11434/v1

# Model name for Secondary LLM (default: local Hunyuan model)
# Use smaller/faster model for quality stages
# Examples: mistral:7b, qwen:7b, local Mistral variant
MODEL_PROOFREAD=tencent/Hunyuan-MT-7B

# S_PROMT_PROOFREAD: Whether model supports system prompts
# Same rules as S_PROMT_TRANSLATE
# Default: false
S_PROMT_PROOFREAD=false

# TEMP_PROOFREAD: Base temperature for proofreading (fallback)
# Higher value for more thorough review
# Default: 0.7
TEMP_PROOFREAD=0.7

# TIMEOUT_PROOFREAD: Request timeout in milliseconds for proofread API
# Default: 6000 (6 seconds)
TIMEOUT_PROOFREAD=6000

# NOTHINK_PROOFREAD: Disable thinking mode for proofread model
# Default: false
NOTHINK_PROOFREAD=false

# =============================================================================
# IMAGES API (Cover Generation - Optional)
# =============================================================================

# API key for image generation (optional)
# Set if you want to generate book covers
API_KEY_IMAGES=

# Base URL for images API
API_BASE_IMAGES=

# Model for image generation (default: OpenAI GPT-Image)
MODEL_IMAGES=gpt-image-1.5

# Cover generation prompt (optional)
# Use placeholders {title}, {author}, {genre} for dynamic content
COVER_PROMPT=Create a book cover for {title} by {author}

# =============================================================================
# SOURCE AND TARGET LANGUAGES
# =============================================================================

# SOURCE_LANG: Language of the source book (default: english)
# Supported: english, russian, chinese, japanese, german, spanish, french, italian, portuguese, korean, and more
SOURCE_LANG=english

# TARGET_LANG: Language to translate to (default: russian)
TARGET_LANG=russian

# COUNTRY: Country name for localization context
# Used by NER to disambiguate location names
# Default: Russia
COUNTRY=Russia

# =============================================================================
# FILE SETTINGS
# =============================================================================

# FILE: Path to the source book file (relative or absolute)
# Supported formats: FB2, EPUB, TXT
# Default: books/Cargo.fb2
FILE=books/ExampleBook.fb2

# =============================================================================
# PROCESSING SETTINGS
# =============================================================================

# MAX_LEN_CHUNK: Maximum chunk size in characters (default: 8192)
# Important: Do not exceed 8192 characters to avoid token limit degradation
# recommended: 6192 for safety margin
MAX_LEN_CHUNK=6192

# LENGTH_CHECK_THRESHOLD: Rechunking threshold percentage (default: 20)
# If a chunk is more than this percentage of MAX_LEN_CHUNK, it will be split
# Lower values = more aggressive splitting
LENGTH_CHECK_THRESHOLD=20

# FAST_TRANS: Enable fast translation mode (default: true/ON)
# When 'true': skips stages 2-4 (REFLECTION, IMPROVE, FINAL_EDIT)
# Result: only INITIAL stage + SYNOPSIS
# Speed boost: ~2.5x faster but lower quality
# Use for: Draft translations, technical docs, prototype work
# NOT for: Final publication, literary translation, professional work
FAST_TRANS=on

# DEBUG: Enable debug mode (default: off)
# When 'on': logs detailed information about:
#   - LLM requests/responses
#   - Chunk processing time
#   - Token statistics
#   - NER extraction
#   - Vocabulary matching
# Default: off
DEBUG=off

# =============================================================================
# NER (Named Entity Recognition)
# =============================================================================

# NER: Enable Named Entity Recognition (default: true)
# When 'true': extracts and tracks named entities (people, organizations, locations)
# This ensures consistent translation of names throughout the book
#Requirement: spaCy with appropriate language model installed
# Example: pip install spacy && python -m spacy download en_core_web_lg
NER=true

# NERMODEL: spaCy model for NER processing (auto-determined from SOURCE_LANG)
# Default is auto-selected based on SOURCE_LANG mapping:
#   english/en -> en_core_web_lg
#   russian/ru -> ru_core_news_lg
#   chinese/zh -> zh_core_web_lg
#   japanese/ja -> ja_core_news_lg
#   and more (see config.py for full mapping)
# Override with custom model if needed
NERMODEL=

# Concurrent request limit for parallel processing (default: 1)
# Set > 1 only if your LLM infrastructure supports it
# Default: 1 (sequential processing)
CONCURRENT_LIMIT=1

# =============================================================================
# OUTPUT SETTINGS
# =============================================================================

# OUTPUT_FORMAT: Target output format (default: fb2)
# Options: 'fb2' or 'epub'
#-'fb2': FictionBook format (native Sunny Narrator format)
#-'epub': EPUB format for e-readers
OUTPUT_FORMAT=fb2

# FB2_AUTO_REPAIR: Enable automatic FB2 XML repair (default: false)
# When 'true': saves both original and _fixed versions on XML validation failure
# Useful for debugging FB2 format issues
# Default: false (fails on XML errors)
FB2_AUTO_REPAIR=false

# =============================================================================
# CALIBRE PIPELINE SETTINGS (DOCX/EPUB/PDF output only)
# =============================================================================

# PANDOC_BATCH_CHARS: pandoc converts a book's markdown to HTML in batches of
# this many characters instead of one call for the whole book. Prevents
# pandoc from hanging/OOMing on large books (default: 200000)
PANDOC_BATCH_CHARS=200000

# PANDOC_TIMEOUT: seconds before a single pandoc batch conversion is killed
# instead of hanging forever (default: 900)
PANDOC_TIMEOUT=900

# CALIBRE_TIMEOUT: seconds before ebook-convert is killed instead of hanging
# forever (default: 1800)
CALIBRE_TIMEOUT=1800

# MAX_FAILED_CHUNK_RATIO: fraction (0.0-1.0) of translation chunks allowed to
# fail before the Calibre pipeline aborts (default: 0.0 = any failure aborts)
MAX_FAILED_CHUNK_RATIO=0.0

# DEBUG_HTTP: when 'off' (default), suppresses noisy DEBUG logging from
# pypandoc/httpx/httpcore/openai even when DEBUG=on. Set 'on' for full traces.
DEBUG_HTTP=off

# =============================================================================
# SHORT PASS SETTINGS (Optional)
# =============================================================================

# SHORT: Filename for short pass output (optional)
# When set: only processes sections mentioned in this file
# Format: One section ID per line, matching FB2 <section id="...">
# Used for testing or partial translations
SHORT=

# =============================================================================
# EXAMPLE ABBREVIATION (Optional)
# =============================================================================

# EXAMPLE: Filename for example abbreviation file (optional)
# Used for custom abbreviation handling during translation
EXAMPLE=

# =============================================================================
# LLM LOGGING (Optional)
# =============================================================================

# LLM_LOGGING: Enable detailed logging of all LLM calls (default: false)
# When 'true': logs every prompt and response to JSONL files
# Logs location: LLM_LOGGING_DIR/llm_calls_YYYY-MM-DD.log
# Format: One JSON object per line with request/response metadata
# Use for: Debugging, auditing, performance analysis
LLM_LOGGING=false

# LLM_LOGGING_DIR: Directory for LLM logs (default: logs)
# Creates logs/ directory if it doesn't exist
LLM_LOGGING_DIR=logs

# =============================================================================
# EXAMPLE CONFIGURATIONS
# =============================================================================

