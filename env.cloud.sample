# Sunny Narrator - quick start in the cloud (no GPU needed)
# =========================================================
# cp env.cloud.sample .env, put your key into API_KEY_TRANSLATE and
# API_KEY_PROOFREAD, your book into FILE, then:
#   python app.py   - the first run builds the dictionary <book>_<lang>.dic
#                     (books/mybook_ru.dic) and stops for you to review it
#   python app.py   - the second run picks it up and translates the whole book
#
# The same two models as the reference local setup (env.sample), served by
# OpenRouter (https://openrouter.ai, pay per token, card or crypto):
#   translate: Gemma 4 26B A4B   https://openrouter.ai/google/gemma-4-26b-a4b-it
#   proofread: Qwen 3.6 35B A3B  https://openrouter.ai/qwen/qwen3.6-35b-a3b
# The providers serve these weights in their own quantization (bf16, fp8, fp4),
# not the Unsloth GGUF a local llama.cpp runs; the result can differ slightly
# from a local run. A 4-bit quantization translates well too.
#
# Cost, estimated from the tokens of a real run (about 4 tokens per source
# character for all stages): ~$0.3 for the demo book (206k characters),
# ~$1 for a 450-page novel (800k characters). The OpenRouter activity page
# shows the exact spending. FAST_TRANS=true (a draft, also the way to grow the
# dictionary with DICT_AUTO_SAVE=true) costs far less: it skips the three
# proofreading stages, most of the cost.
#
# ProxyAPI (https://proxyapi.ru, payment in rubles from Russia): a ProxyAPI key
# in API_KEY_*, and uncomment the PROXYAPI block at the end of this file.
#
# Everything not set here keeps its default; env.sample documents every option.

# --- the book --------------------------------------------------------------
# EPUB/DOCX/PDF need Calibre and pandoc (sudo apt install calibre pandoc);
# an FB2 or TXT book does not. The dictionary is <book>_<lang>.dic next to the
# book, <lang> the code of TARGET_LANG. The demo books (English, public
# domain; with their dictionary in books/ the first run translates at once):
#   FILE=books/eternal-moment.pg.epub
#   FILE=books/forster-short-fiction.se.epub
FILE=books/mybook.epub
SOURCE_LANG=en
TARGET_LANG=ru
OUTPUT_FORMAT=epub

# --- translate LLM ---------------------------------------------------------
API_KEY_TRANSLATE=sk-or-v1-your-key
API_BASE_TRANSLATE=https://openrouter.ai/api/v1
MODEL_TRANSLATE=google/gemma-4-26b-a4b-it
TIMEOUT_TRANSLATE=600

# --- proofread LLM ---------------------------------------------------------
API_KEY_PROOFREAD=sk-or-v1-your-key
API_BASE_PROOFREAD=https://openrouter.ai/api/v1
MODEL_PROOFREAD=qwen/qwen3.6-35b-a3b
TIMEOUT_PROOFREAD=600

# Cover generation (a paid image call per book) stays off while this is empty
API_KEY_IMAGES=

# Thinking off (the default, written here to be seen): the stages expect the
# answer itself, and Qwen 3.6 on OpenRouter thinks unless told not to - paid
# tokens and slower chunks. Sent as reasoning.effort "none".
NOTHINK_TRANSLATE=1
NOTHINK_PROOFREAD=1

# OpenRouter routes to the cheapest provider by default, and some providers
# of Qwen 3.6 have no JSON mode, which every stage uses. These lines keep to
# the providers that support every parameter of the request (JSON mode,
# presence_penalty); any quantization. To prefer a quantization add e.g.
# "quantizations": ["bf16", "fp8"] next to require_parameters.
EXTRA_BODY_TRANSLATE={"provider": {"require_parameters": true}}
EXTRA_BODY_PROOFREAD={"provider": {"require_parameters": true}}

# A hosted API serves both models at once: the next chunk starts its
# translation while this one is proofread (about 1.4x faster)
PARALLEL_STAGES=2

# --- logs (see docs/LOGGING.md) ----------------------------------------------
# Every LLM call with its tokens and time: logs/llm_calls_YYYY-MM-DD.log
LLM_LOGGING=true
LLM_LOGGING_DIR=logs

# --- PROXYAPI (https://proxyapi.ru) - uncomment instead of OpenRouter ----------
# The same model names; the keys above are ProxyAPI keys. The provider choice
# above is OpenRouter's own: emptied here.
# API_BASE_TRANSLATE=https://api.proxyapi.ru/v1
# API_BASE_PROOFREAD=https://api.proxyapi.ru/v1
# EXTRA_BODY_TRANSLATE=
# EXTRA_BODY_PROOFREAD=
