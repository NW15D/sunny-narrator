# CPU-only Dockerfile for Sunny Narrator
# Use this for systems without NVIDIA GPU

FROM python:3.11-slim-bookworm

# Set environment variables
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONPATH=/app

# Set working directory
WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3-pip \
    python3-dev \
    libxml2-dev \
    libxslt1-dev \
    git \
    curl \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

# Calibre (ebook-convert) and pandoc for the EPUB/DOCX/PDF pipeline.
# pandoc is pinned to the release the project is tested with (the Debian one
# is older). ebook-convert runs headless; Qt WebEngine (PDF output) needs
# --no-sandbox as root.
ARG PANDOC_VERSION=3.12
ENV QT_QPA_PLATFORM=offscreen
ENV QTWEBENGINE_CHROMIUM_FLAGS=--no-sandbox
RUN apt-get update && apt-get install -y --no-install-recommends calibre curl ca-certificates \
    && arch="$(dpkg --print-architecture)" \
    && curl -fsSL -o /tmp/pandoc.deb \
       "https://github.com/jgm/pandoc/releases/download/${PANDOC_VERSION}/pandoc-${PANDOC_VERSION}-1-${arch}.deb" \
    && dpkg -i /tmp/pandoc.deb && rm /tmp/pandoc.deb \
    && rm -rf /var/lib/apt/lists/* && apt-get clean \
    && ebook-convert --version && pandoc --version

# Upgrade pip
RUN python3 -m pip install --upgrade pip setuptools wheel

# Copy the dependency manifest first for better layer caching
COPY pyproject.toml .

# Install Python dependencies (CPU-only). torch comes from PyTorch's CPU
# index first, so the project install below is already satisfied and does not
# pull the much larger default CUDA build. The [gpu] extra is deliberately
# not installed here - use the GPU Dockerfile for that.
RUN python3 -m pip install --no-cache-dir \
        --index-url https://download.pytorch.org/whl/cpu torch && \
    python3 -m pip install --no-cache-dir .

# Download spaCy models (multi-language support)
RUN python3 -m spacy download en_core_web_lg && \
    python3 -m spacy download ru_core_news_lg && \
    python3 -m spacy download de_core_news_lg && \
    python3 -m spacy download fr_core_news_lg && \
    python3 -m spacy download es_core_news_lg

# Copy application code
COPY app.py .
COPY src/ ./src/
COPY docs/ ./docs/
COPY README*.md .

# Create directories for volumes
RUN mkdir -p /app/books /app/output

ENV NER=true

# Health check (CPU mode)
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD python3 -c "import spacy; nlp = spacy.load('en_core_web_lg'); print('SPAcy CPU: OK')" || exit 1

# Default entrypoint
ENTRYPOINT ["python3", "app.py"]

# Labels for documentation
LABEL version="2.9.1"
LABEL description="Sunny Narrator - AI-powered book translation (CPU-only)"
LABEL gpu="false"
LABEL author="Sunny Narrator Team"
