# Каталог с данными: data/app.db (SQLite) + data/uploads/{id}/{filename}
DATA_DIR=./data

# Лимиты размера загружаемого .dic-файла (см. prototype.md, раздел 11 —
# однозначного порога из требований не было, здесь только жёсткий верхний
# потолок + защита от пустых файлов; поправьте под финальное решение).
MIN_FILE_SIZE_BYTES=1
MAX_FILE_SIZE_BYTES=33554432

# Секрет для подписи сессий — обязательно сменить в проде.
SESSION_SECRET=change-me-in-production

# Провайдер отправки email-кодов: console (по умолчанию, для разработки —
# код только пишется в лог) | resend | smtp2go
EMAIL_PROVIDER=console
RESEND_API_KEY=
RESEND_FROM=noreply@example.com
SMTP2GO_API_KEY=
SMTP2GO_FROM=noreply@example.com

CODE_TTL_MINUTES=15
CODE_MAX_ATTEMPTS=5

HOST=0.0.0.0
PORT=8000
